msgstr "按需（Worker 控制）"

msgid "on-demand (recommended)"
msgstr "按需（推荐）"

msgid "on-demand: tunnel closed by default, opened from outside via the Worker control plane. always-on: tunnel connected at boot."
msgstr "按需：隧道默认关闭，由 Worker 控制面从外网开启。常驻：开机即连接。"

msgid "running"
msgstr "运行中"

msgid "stopped"
msgstr "已停止"

msgid "unreachable"
msgstr "不可达"

msgid "waiting for auth URL…"
msgstr "等待授权 URL…"

