#!/bin/sh /etc/rc.common
# hometunnel — 数据面：cloudflared tunnel run（locally-managed）
# ondemand 模式下本服务【刻意不 enable】：只由 hometunnel-ctl 守护按需拉起。
# alwayson 模式下由 hometunnel.sh apply-mode enable。
#
# 灵感与语义来源: AI-X-Space/llm-ondemand-tunnel（cloudflared-llm.service 同款设计）

USE_PROCD=1
START=99
STOP=15

NAME=hometunnel
CONF=/etc/hometunnel/config.yml
PROG=/usr/bin/cloudflared

EXTRA_HELP="
	status	查询隧道进程状态（由 rc.common status 提供）
	注意: ondemand 模式下请勿手动 enable 本服务
"

start_service() {
	config_load "$NAME"

	local enabled tunnel_id protocol metrics_port
	config_get_bool enabled global enabled 1
	config_get tunnel_id global tunnel_id ''
	config_get protocol global protocol auto
	config_get metrics_port global metrics_port 20241

	[ "$enabled" -eq 1 ] || {
		logger -t "$NAME" "disabled in UCI, refusing to start"
		return 1
	}
	[ -n "$tunnel_id" ] || {
		logger -t "$NAME" "tunnel_id empty (wizard incomplete), refusing to start"
		return 1
	}
	[ -f "$CONF" ] || {
		logger -t "$NAME" "$CONF missing, run 'hometunnel.sh regen' first"
		return 1
	}

	procd_open_instance "$NAME"
	procd_set_param command "$PROG" "tunnel" "--no-autoupdate"
	[ "$protocol" = "auto" ] || procd_append_param command "--protocol" "$protocol"
	procd_append_param command "--config" "$CONF"
	procd_append_param command "--metrics" "127.0.0.1:${metrics_port}"
	procd_append_param command "run"
	# 崩溃自动拉起：守护/用户决定开关，进程级故障交给 procd
	procd_set_param respawn 3600 5 0
	procd_set_param stderr 1
	procd_set_param stdout 1
	# cloudflared 收 SIGTERM 后优雅断连，给活跃流 10s 收尾
	procd_set_param term_timeout 10
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "$NAME"
}

reload_service() {
	# 配置变更（gen-yml 重生成 config.yml）→ 平滑重启实例
	stop
	start
}
